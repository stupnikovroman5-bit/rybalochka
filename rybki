<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Fishing Simulator</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; user-select:none; -webkit-tap-highlight-color:transparent; }
  
  body {
    font-family: 'Courier New', Courier, monospace;
    background: linear-gradient(180deg,#001a33 0%,#003d66 50%,#005c99 100%);
    min-height:100vh; color:#fff; overflow-x:hidden;
    display:flex; flex-direction:column; align-items:center;
    padding:10px; gap:8px;
  }

  .stats {
    display:flex; gap:8px; flex-wrap:wrap; justify-content:center;
    background:rgba(0,40,80,.7); border:1px solid #00d4ff55;
    border-radius:10px; padding:8px; font-size:14px; font-weight:bold;
    width:100%; max-width:500px;
  }
  .stats span { color:#00ffcc; }
  .stats .rank { color:#ffcc00; }
  .stats .day { color:#ffaa00; }

  .xp-bar-wrap { width:100%; max-width:500px; background:rgba(0,20,40,.75); border:1px solid #00d4ff33; border-radius:10px; padding:8px; margin-bottom: 4px;}
  .xp-top { display:flex; justify-content:space-between; font-size:12px; color:#aaddff; margin-bottom:4px; font-weight:bold; }
  .xp-top .rank { color:#ffcc00; }
  .xp-bar { height:8px; background:rgba(0,0,0,.5); border-radius:4px; overflow:hidden; }
  .xp-fill { height:100%; width:0%; background:#ffcc00; border-radius:4px; transition:width .3s ease; }
  .energy-bar { height:6px; background:rgba(0,0,0,.5); border-radius:3px; overflow:hidden; margin-top:2px;}
  .energy-fill { height:100%; width:100%; background:#ff4444; border-radius:3px; transition:width .3s ease; }

  .tabs { 
    display:flex; flex-wrap:wrap; gap:4px; justify-content:center;
    width:100%; max-width:500px; 
    background:rgba(0,20,40,.7); border-radius:10px; padding:4px; 
    border:1px solid #00d4ff33; 
  }
  .tab { 
    flex: 1 1 22%; min-width: 90px;
    padding:8px 4px; border:none; border-radius:6px; cursor:pointer; 
    background:transparent; color:#88bbdd; font-size:12px; font-family:inherit; font-weight:bold; text-align: center; 
  }
  .tab.active { background:linear-gradient(135deg,#00d4ff,#0077cc); color:#001a33; }

  button { font-family:inherit; font-size:12px; font-weight:bold; padding:8px; border:none; border-radius:8px; cursor:pointer; background:linear-gradient(135deg,#00d4ff,#0077cc); color:#001a33; transition:transform .1s; }
  button:active { transform:scale(.96); }
  button:disabled { opacity:.4; cursor:not-allowed; }
  button.sell { background:linear-gradient(135deg,#00ff88,#00aa55); color:#002211; }
  .full { grid-column:1/-1; }

  .toast-container { position:fixed; top:10px; left:50%; transform:translateX(-50%); z-index:150; display:flex; flex-direction:column; gap:6px; pointer-events:none; width:100%; max-width:400px; padding:0 10px; }
  .toast { background:rgba(0,30,60,.95); border-left:3px solid #00d4ff; border-radius:8px; padding:10px; font-size:12px; font-weight:bold; box-shadow:0 4px 20px #000000aa; animation:toastIn .3s, toastOut .4s 2.2s forwards; }
  @keyframes toastIn { from { opacity:0; transform:translateY(-10px); } to { opacity:1; transform:translateY(0); } }
  @keyframes toastOut { to { opacity:0; transform:translateY(-10px); } }
  
  .rarity-trash { color:#888; border-color:#888 !important; }
  .rarity-ru { color:#00dd88; border-color:#00dd88 !important; }
  .rarity-craft { color:#00aaff; border-color:#00aaff !important; }
  .rarity-used { color:#cc66ff; border-color:#cc66ff !important; }
  .rarity-import { color:#ffcc00; border-color:#ffcc00 !important; }
  .rarity-custom { color:#ff4444; border-color:#ff4444 !important; }

  .modal { position:fixed; inset:0; background:rgba(0,0,0,.85); display:none; align-items:center; justify-content:center; z-index:100; padding:15px; }
  .modal.show { display:flex; }
  .modal-box { background:#001a33; border:2px solid #ffcc00; border-radius:12px; padding:15px; max-width:350px; width:100%; text-align:center; max-height:80vh; overflow-y:auto; }
  .modal-box h2 { color:#ffcc00; margin-bottom:10px; font-size:16px; }

  .inventory { width:100%; max-width:500px; display:none; flex-direction:column; gap:8px; }
  .inventory.show { display:flex; }
  .inv-section { background:rgba(0,20,40,.75); border:1px solid #00d4ff33; border-radius:10px; padding:10px; }
  .inv-title { font-size:14px; font-weight:bold; color:#00d4ff; margin-bottom:8px; display:flex; justify-content:space-between; }
  .inv-hint { font-size:12px; color:#88bbdd; margin-bottom:6px; text-align:center; font-style:italic; }
  
  .inv-row { display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; }
  .inv-item { min-width:70px; flex-shrink:0; display:flex; flex-direction:column; align-items:center; background:rgba(0,60,100,.5); border-radius:8px; padding:6px 4px; border:1px solid #00d4ff22; cursor:pointer; }
  .inv-item .name { font-size:12px; color:#aaddff; margin-top:4px; text-align:center; line-height: 1.2; }
  .inv-item .count { position:absolute; top:2px; right:2px; background:#00d4ff; color:#001a33; font-size:10px; font-weight:bold; padding:1px 4px; border-radius:4px; }
  .inv-item .price { font-size:12px; color:#ffcc00; margin-top:2px; font-weight:bold; }
  .inv-empty { color:#557799; font-size:12px; padding:6px 0; text-align:center; }

  .shop-category-title { font-size:14px; font-weight:bold; color:#ffcc00; margin:10px 0 6px 0; border-bottom:1px solid #ffcc0033; padding-bottom:4px; }
  .shop-category-title:first-child { margin-top:0; }
  .shop-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; }
  .shop-item { background:rgba(0,60,100,.5); border:1px solid #00d4ff22; border-radius:8px; padding:8px; display:flex; flex-direction:column; justify-content:space-between; }
  .shop-item .si-type { font-size:10px; color:#88bbdd; margin-bottom:4px; display:block; }
  .shop-item .si-name { font-size:13px; color:#fff; margin-bottom:4px; line-height: 1.2; font-weight:bold; }
  .shop-item .si-desc { font-size:11px; color:#aaddff; margin-bottom:6px; }
  .si-buy { width:100%; padding:6px; font-size:12px; margin-top:auto; background:rgba(0,212,255,.2); color:#00d4ff; border:1px solid #00d4ff; border-radius:4px; cursor:pointer; font-weight:bold; }
  .si-buy:disabled { opacity:.4; border-color:#555; color:#555; }

  .rod-assembly { background:rgba(0,20,40,.75); border:1px solid #00d4ff33; border-radius:10px; padding:10px; margin-bottom:8px; }
  .slot-row { display:flex; justify-content:space-between; align-items:center; background:rgba(0,0,0,.3); border-radius:6px; padding:10px; margin-bottom:4px; cursor:pointer;}
  .slot-row .rs-label { font-size:12px; color:#88bbdd; width:80px; }
  .slot-row .rs-val { font-size:12px; font-weight:bold; text-align:right; flex:1; color: #00ff88; line-height: 1.2;}
  .repair-btn { background:#ffaa00; color:#001a33; border:none; padding:2px 6px; border-radius:4px; font-size:10px; margin-left:6px; cursor:pointer; font-weight:bold;}

  .pond { position:relative; width:100%; max-width:500px; height:160px; background: radial-gradient(ellipse at 50% 30%, #0a6ea8 0%, #043d63 60%, #02243d 100%); border-radius:12px; overflow:hidden; cursor:pointer; border:2px solid #00d4ff66; }
  .pond.tazik { background: radial-gradient(circle at 50% 50%, #b87333 0%, #6e3d1a 70%, #3a1e0a 100%); border-color: #ffcc00; }
  .bg-fish { position: absolute; width: 20px; height: 10px; background: rgba(0, 212, 255, 0.3); border-radius: 50%; pointer-events: none; }
  .bg-fish::after { content: ''; position: absolute; top: 20%; right: -6px; border-top: 3px solid transparent; border-bottom: 3px solid transparent; border-left: 6px solid rgba(0, 212, 255, 0.3); }
  @keyframes swimRight { 0% { transform: translateX(-50px); } 100% { transform: translateX(550px); } }
  @keyframes swimLeft { 0% { transform: translateX(550px) scaleX(-1); } 100% { transform: translateX(-50px) scaleX(-1); } }
  .wave { position:absolute; width:200%; height:100%; top:0; left:-50%; background: radial-gradient(ellipse at center, transparent 60%, #00d4ff11 100%); animation: wave 6s linear infinite; }
  @keyframes wave { 0%{transform:translateX(0)} 100%{transform:translateX(25%)} }
  .float-text { position:absolute; font-size:14px; font-weight:bold; pointer-events:none; animation:floatUp 1s ease-out forwards; text-shadow:0 0 10px currentColor; z-index:10; }
  @keyframes floatUp { 100% { opacity:0; transform:translateY(-50px); } }
  .status { font-size:14px; font-weight:bold; min-height:20px; color:#00ffcc; text-align:center; margin-top:10px; }

  .bank-card { background:rgba(0,20,40,.75); border:1px solid #66ccff44; border-radius:10px; padding:10px; margin-bottom:8px; }
  .bank-card-title { font-size:14px; font-weight:bold; color:#66ccff; margin-bottom:8px; display:flex; justify-content:space-between; border-bottom:1px solid #66ccff33; padding-bottom:6px; }
  .dep-opt { display:flex; justify-content:space-between; align-items:center; background:rgba(0,60,100,.5); border:1px solid #66ccff33; border-radius:6px; padding:8px; margin-bottom:6px; cursor:pointer; }
  .dep-opt .dep-name { font-size:12px; color:#aaddff; font-weight:bold; }
  .dep-opt .dep-rate { font-size:10px; color:#00ff88; margin-top:2px; }
  .dep-opt .dep-get { font-size:13px; color:#ffcc00; text-align:right; font-weight:bold; }
  .active-dep { background:rgba(0,60,100,.5); border:1px solid #66ccff33; border-radius:6px; padding:8px; margin-bottom:6px; display:flex; justify-content:space-between; align-items:center; }
  .active-dep .ad-name { font-size:12px; color:#aaddff; font-weight:bold; }
  .active-dep .ad-status { font-size:10px; color:#ffaa00; }
  .active-dep .ad-amount { color:#00ff88; font-size:14px; font-weight:bold; }
  .reset-btn { background:#ff4444 !important; color:#fff !important; margin-top:10px; width:100%; font-size:14px; padding:12px; }

  /* ИВЕНТ 100 УРОВНЯ */
  .event-overlay {
    position:fixed; inset:0; background:rgba(0,0,0,0.95); z-index:9999;
    display:none; flex-direction:column; align-items:center; justify-content:center;
    padding:20px; text-align:center; color:#fff;
  }
  .event-overlay.show { display:flex; }
  .event-overlay h1 { color:#ffcc00; font-size:26px; margin-bottom:20px; text-shadow:0 0 20px #ffcc00; animation:pulse 1.5s infinite; font-weight:bold; }
  .event-overlay p { font-size:16px; font-weight:bold; line-height:1.8; margin-bottom:30px; max-width:500px; }
  .event-overlay button { font-size:16px; padding:15px 30px; background:#00ff88; color:#002211; border-radius:10px; border:none; cursor:pointer; font-family:inherit; font-weight:bold; }
  @keyframes pulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.05);} }

  /* ДОСТИЖЕНИЕ */
  .achievement {
    background: linear-gradient(135deg, #ffcc00, #ff8800);
    color: #001a33; padding: 15px; border-radius: 10px;
    text-align: center; font-size: 16px; font-weight: bold;
    box-shadow: 0 0 20px #ffcc00aa; margin-top: 20px;
    animation: pulse 2s infinite;
  }
  
  /* СЕТКА ДОСТИЖЕНИЙ */
  .ach-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
  }
  .ach-item {
    background: rgba(0,60,100,.5); border: 1px solid #00d4ff22;
    border-radius: 8px; padding: 8px; display: flex; align-items: center; gap: 8px;
  }
  .ach-item.locked { opacity: 0.4; }
  .ach-icon { font-size: 20px; color: #ffcc00; }
  .ach-info { display: flex; flex-direction: column; gap: 2px; }
  .ach-name { font-size: 12px; color: #fff; font-weight: bold; }
  .ach-desc { font-size: 10px; color: #88bbdd; }

  /* СТИЛЬ ДЛЯ ЛОКАЦИЙ */
  .loc-card { background:rgba(0,20,40,.75); border:1px solid #00d4ff33; border-radius:10px; padding:15px; margin-bottom:10px; text-align:center; }
  .loc-title { font-size:20px; font-weight:bold; color:#00d4ff; margin-bottom:10px; text-transform:uppercase; }
  .loc-btn { width:100%; padding:10px; font-size:14px; }
</style>
</head>
<body>

<div class="toast-container" id="toastContainer"></div>

<!-- ИВЕНТ 100 УРОВНЯ -->
<div class="event-overlay" id="eventOverlay">
  <h1>ПОЗДРАВЛЯЕМ!</h1>
  <p>
    ВЫ ПРОШЛИ ИГРУ!<br>
    ВЫ ДОСТИГЛИ НАВЫКА РЫБАЛКИ ДЕДА,<br>
    ОН ГОРДИТСЯ ВАМИ.<br>
    ОН ХОЧЕТ С ВАМИ ПОРЫБАЧИТЬ.<br><br>
    ДАЛЕЕ ВЫ МОЖЕТЕ ПРОДОЛЖИТЬ РЫБАЧИТЬ,<br>
    ТЕПЕРЬ ВМЕСТЕ С ДЕДОМ
  </p>
  <button onclick="document.getElementById('eventOverlay').classList.remove('show')">ПРОДОЛЖИТЬ</button>
</div>

<div class="stats">
  <div>Деньги: <span id="money">0</span></div>
  <div>Улов: <span id="catchCount">0</span>/<span id="invCap">10</span></div>
  <div>Ур: <span class="rank" id="rankVal">1</span> (<span id="rankName">Нуб</span>)</div>
  <div>День: <span class="day" id="dayVal">1</span></div>
  <div id="debtBadge" style="display:none;color:#ff6666">Долг: <span id="debtVal">0</span></div>
</div>

<div class="xp-bar-wrap">
  <div class="xp-top">
    <span>Опыт: <span id="xpVal">0</span> / <span id="xpNeed">10</span></span>
    <span class="rank" id="rankBadge">1 ур.</span>
  </div>
  <div class="xp-bar"><div class="xp-fill" id="xpFill"></div></div>
  <div class="energy-bar"><div class="energy-fill" id="energyFill"></div></div>
</div>

<div class="tabs">
  <button class="tab active" data-tab="fishing">Рыбалка</button>
  <button class="tab" data-tab="locations">Локации</button>
  <button class="tab" data-tab="garage">Гараж</button>
  <button class="tab" data-tab="market">Рынок</button>
  <button class="tab" data-tab="shop">Магазин</button>
  <button class="tab" data-tab="crates">Ящики</button>
  <button class="tab" data-tab="fishers">Рыбаки</button>
  <button class="tab" data-tab="collection">Коллекция</button>
  <button class="tab" data-tab="achievements">Достижения</button>
  <button class="tab" data-tab="bank">Банк</button>
</div>

<div id="fishingView" style="width:100%; max-width:500px; display:flex; flex-direction:column; gap:8px; align-items:center;">
  <div style="width:100%; text-align:center; font-size:14px; font-weight:bold; color:#00d4ff;" id="currentLocName">Пруд</div>
  <div class="pond" id="pond"><div class="wave"></div></div>
  <div class="status" id="status">Тапни по воде, чтобы забросить</div>
  
  <div style="display:flex; gap:6px; width:100%;">
    <button class="sell" id="sellBtn" style="flex:1;" disabled>Продать улов (0)</button>
    <button id="restBtn" style="flex:1; background:#ffaa00; color:#3a1a00;">Отдохнуть</button>
  </div>
</div>

<div class="inventory" id="locationsView"><div id="locationsList"></div></div>

<div class="inventory" id="garageView">
  <div class="inv-section">
    <div class="inv-title"><span>Удочка</span></div>
    <div class="rod-assembly">
      <div class="slot-row" onclick="openPicker('rod', 'rod')">
        <div class="rs-label">Удилище</div>
        <div class="rs-val" id="gRod">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('rod', 'reel')">
        <div class="rs-label">Катушка</div>
        <div class="rs-val" id="gReel">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('rod', 'line')">
        <div class="rs-label">Леска</div>
        <div class="rs-val" id="gLine">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('rod', 'hook')">
        <div class="rs-label">Крючок</div>
        <div class="rs-val" id="gHook">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('rod', 'float')">
        <div class="rs-label">Поплавок</div>
        <div class="rs-val" id="gFloat">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('rod', 'bait')">
        <div class="rs-label">Наживка</div>
        <div class="rs-val" id="gBait">-</div>
      </div>
    </div>
    <div style="font-size:12px;color:#88bbdd;text-align:center;margin-top:8px;font-weight:bold">
      Скорость: <span id="statSpeed" style="color:#00d4ff">+0%</span> | 
      Удача: <span id="statLuck" style="color:#cc66ff">+0%</span>
    </div>
  </div>

  <div class="inv-section">
    <div class="inv-title"><span>Лодка</span></div>
    <div class="rod-assembly">
      <div class="slot-row" onclick="openPicker('boat', 'motor')">
        <div class="rs-label">Мотор</div>
        <div class="rs-val" id="gMotor">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('boat', 'hull')">
        <div class="rs-label">Корпус</div>
        <div class="rs-val" id="gHull">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('boat', 'radar')">
        <div class="rs-label">Радар</div>
        <div class="rs-val" id="gRadar">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('boat', 'elec')">
        <div class="rs-label">Электроника</div>
        <div class="rs-val" id="gElec">-</div>
      </div>
      <div class="slot-row" onclick="openPicker('boat', 'hold')">
        <div class="rs-label">Трюм</div>
        <div class="rs-val" id="gHold">-</div>
      </div>
    </div>
  </div>

  <div class="inv-section">
    <div class="inv-title"><span>Улов</span><span id="invFishTotal" style="color:#ffcc00">0</span></div>
    <div style="display:flex; justify-content:space-between; font-size:12px; font-weight:bold; margin-bottom:6px; color:#aaddff;">
      <span>Занято: <span id="invFill">0</span>/<span id="invCap2">10</span></span>
      <div style="flex:1; height:6px; background:rgba(0,0,0,.5); border-radius:3px; margin:0 8px; overflow:hidden;"><div style="height:100%; width:0%; background:#00d4ff;" id="invCapFill"></div></div>
      <button id="expandInv" style="padding:2px 8px;font-size:10px;border-radius:4px;background:#00d4ff;color:#001a33;border:none;cursor:pointer;font-weight:bold;">+5 слотов</button>
    </div>
    <div class="inv-hint" id="invHintText">Тапни по рыбе — продать.</div>
    <div class="inv-row" id="invFishRow"><div class="inv-empty">Пока пусто. Иди ловить!</div></div>
  </div>

  <div class="inv-section">
    <div class="inv-title"><span>Энергетики</span></div>
    <div class="inv-row" id="invEnergyRow"><div class="inv-empty">Нет предметов</div></div>
  </div>
</div>

<div class="inventory" id="marketView">
  <div class="inv-section">
    <div class="inv-title"><span>Продажа</span><span style="color:#ffcc00">Улов: <span id="marketCatchCount">0</span></span></div>
    <div class="market-row" id="marketSellGrid"></div>
  </div>
  <div class="inv-section">
    <div class="inv-title"><span>Покупка</span><span style="color:#ffcc00">Баланс: <span id="marketMoney">0</span></span></div>
    <div class="market-row" id="marketBuyGrid"></div>
  </div>
</div>

<div class="inventory" id="shopView">
  <div class="inv-section">
    <div class="inv-title"><span>Магазин</span><span style="color:#ffcc00">Баланс: <span id="shopMoney">0</span></span></div>
    <div id="shopContainer"></div>
  </div>
</div>

<div class="inventory" id="cratesView">
  <div class="inv-section">
    <div class="inv-title"><span>Ящики</span><span style="color:#ffcc00">Баланс: <span id="crateMoney">0</span></span></div>
    
    <div class="shop-category-title">Ящики со снастями</div>
    <div class="shop-grid" id="crateGrid"></div>
    
    <div class="shop-category-title">Ящики с деталями лодки</div>
    <div class="shop-grid" id="boatCrateGrid"></div>

    <div class="shop-category-title">Ящики с рыбой</div>
    <div class="shop-grid" id="fishCrateGrid"></div>
  </div>
</div>

<div class="inventory" id="fishersView">
  <div class="inv-section">
    <div class="inv-title"><span>Рыбаки</span><span style="color:#00ff88" id="fisherCount">0 / 3</span></div>
    <div class="inv-hint">Ловят за тебя рыбу каждый день.</div>
    <div class="inv-row" id="fisherRow"></div>
  </div>
</div>

<div class="inventory" id="collectionView">
  <div class="inv-section">
    <div class="inv-title"><span>Коллекция</span><span id="collProgress">0/0</span></div>
    <div id="collList"></div>
  </div>
</div>

<div class="inventory" id="achievementsView">
  <div class="inv-section">
    <div class="inv-title"><span>Достижения</span><span id="achProgress">0/50</span></div>
    <div class="ach-grid" id="achList"></div>
    <button class="reset-btn" onclick="document.getElementById('resetModal').classList.add('show')">Сбросить прогресс</button>
  </div>
</div>

<div class="inventory" id="bankView">
