if (!state.equipDurability) state.equipDurability = {};
state.ownedEquip.forEach(id => { if (state.equipDurability[id] === undefined) state.equipDurability[id] = 100; });
if (!state.inventoryEnergy) state.inventoryEnergy = {};
if (!state.achievementsUnlocked) state.achievementsUnlocked = [];

function save() { localStorage.setItem('fishing_game_v23', JSON.stringify(state)); }
function getPrice(fishName) { return state.marketPrices[fishName] || 10; }

function getRankInfo(lvl) {
  if (lvl >= 100) return { name: 'НА РЫБАЛКЕ С ДЕДОМ' };
  let current = RANKS[0];
  for(let i=0; i<RANKS.length; i++) { if (lvl >= RANKS[i].lvl) current = RANKS[i]; }
  return current;
}

// УСЛОЖНЕННАЯ ФОРМУЛА ОПЫТА
function getXPNeed(lvl) { return Math.floor(10 + Math.pow(lvl, 1.7) * 8); }

function getStats() {
  let spd = 0, lck = 0;
  const eq = [...Object.values(state.rod), ...Object.values(state.boatParts)];
  eq.forEach(id => {
    const item = EQUIPMENT.find(x => x.id === id);
    if (item && (state.equipDurability[item.id] || 0) > 0) {
      if (item.stat === 'speed') spd += item.val;
      if (item.stat === 'luck') lck += item.val;
    }
  });
  return { spd, lck };
}

function toast(msg) {
  const t = document.getElementById('toastContainer');
  const div = document.createElement('div');
  div.className = 'toast';
  div.textContent = msg;
  t.appendChild(div);
  setTimeout(() => div.remove(), 2500);
}

function checkAchievements() {
  ACHIEVEMENTS.forEach(a => {
    if (!state.achievementsUnlocked.includes(a.id)) {
      if (a.check(state)) {
        state.achievementsUnlocked.push(a.id);
        state.money += a.money;
        state.totalMoneyEarned += a.money;
        state.xp += a.xp;
        let leveledUp = false;
        while (state.xp >= getXPNeed(state.level)) {
          state.xp -= getXPNeed(state.level);
          state.level++;
          leveledUp = true;
        }
        if (leveledUp && state.level >= 100 && !state.gameBeaten) {
          document.getElementById('eventOverlay').classList.add('show');
          state.gameBeaten = true;
          state.ownedBoats.push('boat_ded');
          state.ownedEquip.push('rod_ded', 'reel_ded', 'line_ded', 'hook_ded', 'float_ded', 'bait_ded', 'motor_ded', 'hull_ded', 'radar_ded', 'elec_ded', 'hold_ded');
          state.rod = { rod:'rod_ded', reel:'reel_ded', line:'line_ded', hook:'hook_ded', float:'float_ded', bait:'bait_ded' };
          state.boatParts = { motor:'motor_ded', hull:'hull_ded', radar:'radar_ded', elec:'elec_ded', hold:'hold_ded' };
          ['rod_ded', 'reel_ded', 'line_ded', 'hook_ded', 'float_ded', 'bait_ded', 'motor_ded', 'hull_ded', 'radar_ded', 'elec_ded', 'hold_ded'].forEach(id => {
            state.equipDurability[id] = 9999;
          });
        }
        toast(`🏆 Достижение: ${a.name}! +${a.money}$ +${a.xp}xp`);
      }
    }
  });
  save();
}

let activeFishCount = 0;
function spawnFish() {
  if (activeFishCount >= 8) return;
  const pond = document.getElementById('pond');
  if (state.currentLoc === 'tazik') pond.classList.add('tazik'); else pond.classList.remove('tazik');
  const fish = document.createElement('div');
  fish.className = 'bg-fish';
  const isRight = Math.random() > 0.5;
  const dur = 8 + Math.random()*8;
  fish.style.top = (30 + Math.random() * 60) + '%';
  fish.style.left = isRight ? '-50px' : '100%';
  fish.style.animation = `${isRight ? 'swimRight' : 'swimLeft'} ${dur}s linear forwards`;
  fish.style.transform = `scale(${0.5 + Math.random() * 1.5})`;
  const colors = ['rgba(0, 212, 255, 0.3)', 'rgba(0, 255, 136, 0.3)', 'rgba(255, 204, 0, 0.3)'];
  fish.style.background = colors[Math.floor(Math.random() * colors.length)];
  pond.appendChild(fish);
  activeFishCount++;
  setTimeout(() => { if (fish.parentNode) { fish.parentNode.removeChild(fish); activeFishCount--; } }, dur * 1000);
}

function addXP(amount) {
  state.xp += amount;
  let leveledUp = false;
  let oldRank = getRankInfo(state.level).name;
  while (state.xp >= getXPNeed(state.level)) {
    state.xp -= getXPNeed(state.level);
    state.level++;
    leveledUp = true;
  }
  let newRank = getRankInfo(state.level).name;
  if (leveledUp) {
    if (state.level >= 100 && !state.gameBeaten) {
      document.getElementById('eventOverlay').classList.add('show');
      state.gameBeaten = true;
      state.ownedBoats.push('boat_ded');
      state.ownedEquip.push('rod_ded', 'reel_ded', 'line_ded', 'hook_ded', 'float_ded', 'bait_ded', 'motor_ded', 'hull_ded', 'radar_ded', 'elec_ded', 'hold_ded');
      state.rod = { rod:'rod_ded', reel:'reel_ded', line:'line_ded', hook:'hook_ded', float:'float_ded', bait:'bait_ded' };
      state.boatParts = { motor:'motor_ded', hull:'hull_ded', radar:'radar_ded', elec:'elec_ded', hold:'hold_ded' };
      ['rod_ded', 'reel_ded', 'line_ded', 'hook_ded', 'float_ded', 'bait_ded', 'motor_ded', 'hull_ded', 'radar_ded', 'elec_ded', 'hold_ded'].forEach(id => {
        state.equipDurability[id] = 9999;
      });
      save();
    } else if (oldRank !== newRank && state.level < 100) {
      toast(`Новое звание: ${newRank}!`);
    }
  }
  checkAchievements();
  save(); updateUI();
}

