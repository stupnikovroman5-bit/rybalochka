// ЛОГИКА ЦЕПОЧКИ ПОКУПОК
function getRarityLevel(r) {
  if (r === 'trash') return 0;
  if (r === 'ru') return 1;
  if (r === 'craft') return 2;
  if (r === 'used') return 3;
  if (r === 'import') return 4;
  if (r === 'custom') return 5;
  return 0;
}

function canBuyEquip(item) {
  const lvl = getRarityLevel(item.rarity);
  if (lvl === 0) return true; // С помойки можно всегда

  const prevRarity = ['trash', 'ru', 'craft', 'used', 'import'][lvl - 1];
  
  // Ищем, куплена ли хотя бы одна деталь предыдущей редкости в этом же слоте
  const hasPrev = state.ownedEquip.some(eqId => {
    const eq = EQUIPMENT.find(e => e.id === eqId);
    return eq && eq.type === item.type && eq.rarity === prevRarity;
  });

  if (!hasPrev) {
    return `Сначала купи деталь "${RARITY_META[prevRarity].label}" для этого слота`;
  }
  return true;
}

function renderShop() {
  const c = document.getElementById('shopContainer');
  let html = '';
  const cats = [
    { key: 'rod', name: 'Удилища' }, { key: 'reel', name: 'Катушки' }, { key: 'line', name: 'Лески' }, { key: 'hook', name: 'Крючки' }, { key: 'float', name: 'Поплавки' }, { key: 'bait', name: 'Наживки' },
    { key: 'motor', name: 'Моторы' }, { key: 'hull', name: 'Корпуса' }, { key: 'radar', name: 'Радары' }, { key: 'elec', name: 'Электроника' }, { key: 'hold', name: 'Трюмы' }
  ];

  cats.forEach(cat => {
    html += `<div class="shop-category-title">${cat.name}</div><div class="shop-grid">`;
    const items = EQUIPMENT.filter(x => x.type === cat.key && x.id.indexOf('ded') === -1);
    html += items.map(item => {
      const isOwned = state.ownedEquip.includes(item.id);
      const canBuy = state.money >= item.price;
      const chainCheck = canBuyEquip(item);
      const canBuyFinal = canBuy && (chainCheck === true);
      
      let errorHint = '';
      if (typeof chainCheck === 'string') {
        errorHint = `<div style="font-size:8px; color:#ff6666; margin-top:4px; line-height:1.2;">${chainCheck}</div>`;
      }

      return `<div class="shop-item ${RARITY_META[item.rarity].class}">
        <div class="si-type">${RARITY_META[item.rarity].label}</div>
        <div class="si-name">${item.name}</div>
        <div class="si-desc">+${item.val} ${item.stat === 'speed' ? 'Скорость' : 'Удача'}</div>
        ${isOwned ? `<div style="color:#00ff88; font-size:10px; font-weight:bold; text-align:center;">КУПЛЕНО</div>` : `<button class="si-buy" ${!canBuyFinal ? 'disabled' : ''} onclick="buyEquip('${item.id}', ${item.price})">$${item.price}</button>`}
        ${errorHint}
      </div>`;
    }).join('');
    html += `</div>`;
  });
  
  html += `<div class="shop-category-title">Расходники</div><div class="shop-grid">`;
  html += CONSUMABLES.map(item => {
    const canBuy = state.money >= item.price;
    return `<div class="shop-item"><div class="si-type">Энергия</div><div class="si-name">${item.name}</div><div class="si-desc">+${item.energy} E</div><button class="si-buy" ${!canBuy ? 'disabled' : ''} onclick="buyEnergy('${item.id}', ${item.price})">$${item.price}</button></div>`;
  }).join('');
  html += `</div>`;

  html += `<div class="shop-category-title">Лодки</div><div class="shop-grid">`;
  html += BOATS.filter(b => b.id.indexOf('ded') === -1).map(b => {
    const isOwned = state.ownedBoats.includes(b.id);
    return `<div class="shop-item ${RARITY_META[b.rarity].class}"><div class="si-type">${RARITY_META[b.rarity].label}</div><div class="si-name">${b.name}</div><div class="si-desc">Открывает: ${LOCATIONS.find(l=>l.id===b.loc).name}</div>${isOwned ? `<div style="color:#00ff88; font-size:10px; font-weight:bold; text-align:center;">КУПЛЕНО</div>` : `<button class="si-buy" ${state.money < b.price ? 'disabled' : ''} onclick="buyBoat('${b.id}', ${b.price})">$${b.price}</button>`}</div>`;
  }).join('');
  html += `</div>`;

  c.innerHTML = html;
}

function buyEquip(id, price) { 
  if (state.money < price) return; 
  const item = EQUIPMENT.find(x => x.id === id);
  if (canBuyEquip(item) !== true) return toast(canBuyEquip(item));
  
  state.money -= price; 
  state.ownedEquip.push(id); 
  state.equipDurability[id] = 100;
  checkAchievements();
  save(); updateUI(); toast('Куплено!'); 
}

function buyEnergy(id, price) {
  if (state.money < price) return;
  state.money -= price;
  state.inventoryEnergy[id] = (state.inventoryEnergy[id] || 0) + 1;
  save(); updateUI(); toast('Куплено!');
}

function renderMarket() {
  const sellC = document.getElementById('marketSellGrid');
  const buyC = document.getElementById('marketBuyGrid');
  if (state.catch.length === 0) { sellC.innerHTML = `<div class="inv-empty">Пусто</div>`; } 
  else {
    const grouped = {};
    state.catch.forEach(f => { grouped[f.name] = (grouped[f.name]||0)+1; });
    sellC.innerHTML = Object.keys(grouped).map(name => {
      const fData = LOCATIONS.flatMap(l=>l.fish).find(f=>f.name===name);
      const isToy = fData && fData.price === 0;
      const price = isToy ? 0 : getPrice(name);
      return `<div class="loc-card" style="margin-bottom:6px; padding:8px; display:flex; justify-content:space-between; align-items:center;"><div><div style="font-size:12px; font-weight:bold;">${name} x${grouped[name]}</div><div style="font-size:10px; color:#88bbdd;">${isToy ? 'Не продается' : 'Цена: ' + price}</div></div><button class="si-buy" style="width:auto; padding:4px 8px;" onclick="${isToy ? `toast('Игрушки нельзя продать')` : `sellFish('${name}')`}">${isToy ? 'Игрушка' : 'Продать'}</button></div>`;
    }).join('');
  }

  buyC.innerHTML = LOCATIONS[0].fish.map(f => {
    const p = getPrice(f.name);
    return `<div class="loc-card" style="margin-bottom:6px; padding:8px; display:flex; justify-content:space-between; align-items:center;"><div><div style="font-size:12px; font-weight:bold;">${f.name}</div><div style="font-size:10px; color:#88bbdd;">Цена: ${p}</div></div><button class="si-buy" style="width:auto; padding:4px 8px;" onclick="buyFish('${f.name}', ${p})">Купить</button></div>`;
  }).join('');
}

function sellFish(name) { const idx = state.catch.findIndex(f => f.name === name); if (idx === -1) return; state.money += getPrice(name); state.totalMoneyEarned += getPrice(name); state.catch.splice(idx, 1); save(); updateUI(); toast('Продано'); }
function buyFish(name, price) { if (state.money < price) return toast('Мало денег'); if (state.catch.length >= state.invCap) return toast('Инвентарь полон'); state.money -= price; state.catch.push({ name }); save(); updateUI(); toast('Куплено'); }
function handleFishClick(name) { const fData = LOCATIONS.flatMap(l=>l.fish).find(f=>f.name===name); if (fData && fData.price === 0) releaseFish(name); else sellFish(name); }
function releaseFish(name) { const idx = state.catch.findIndex(f => f.name === name); if (idx === -1) return; const fData = LOCATIONS.flatMap(l=>l.fish).find(f=>f.name===name); const xpGained = FISH_META[fData.rarity].xp; addXP(xpGained); state.catch.splice(idx, 1); save(); updateUI(); toast(`Отпустил ${name} (+${xpGained} xp)`); }

function renderCrates() {
  const c1 = document.getElementById('crateGrid');
  c1.innerHTML = `
    <div class="shop-item" style="text-align:center;"><div class="si-name">Деревянный</div><button class="si-buy" onclick="openCrate(500, 'equip')">$500</button></div>
    <div class="shop-item" style="text-align:center;"><div class="si-name">Железный</div><button class="si-buy" onclick="openCrate(2000, 'equip')">$2000</button></div>
    <div class="shop-item" style="text-align:center;"><div class="si-name">Сейф</div><button class="si-buy" onclick="openCrate(8000, 'equip')">$8000</button></div>
  `;
  const c2 = document.getElementById('boatCrateGrid');
  c2.innerHTML = `
    <div class="shop-item" style="text-align:center;"><div class="si-name">Ящик деталей</div><button class="si-buy" onclick="openCrate(1000, 'boatpart')">$1000</button></div>
    <div class="shop-item" style="text-align:center;"><div class="si-name">Морской сейф</div><button class="si-buy" onclick="openCrate(5000, 'boatpart')">$5000</button></div>
    <div class="shop-item" style="text-align:center;"><div class="si-name">Кейс лодки</div><button class="si-buy" onclick="openCrate(15000, 'boat')">$15000</button></div>
  `;
  const c3 = document.getElementById('fishCrateGrid');
  c3.innerHTML = `
    <div class="shop-item" style="text-align:center;"><div class="si-name">Ящик с рыбой</div><button class="si-buy" onclick="openFishCrate(300)">$300</button></div>
    <div class="shop-item" style="text-align:center;"><div class="si-name">Морской ящик</div><button class="si-buy" onclick="openFishCrate(1500)">$1500</button></div>
  `;
}

function openCrate(price, type) {
  if (state.money < price) return toast('Мало денег');
  state.money -= price;
  state.openedCrates++;
  if (type === 'boat') {
    if (Math.random() < 0.1) {
      const availBoats = BOATS.filter(b => !state.ownedBoats.includes(b.id) && b.price > 0 && b.id.indexOf('ded') === -1);
      if (availBoats.length > 0) {
        const b = availBoats[Math.floor(Math.random() * availBoats.length)];
        state.ownedBoats.push(b.id);
        toast(`ВЫПАЛА ЛОДКА: ${b.name}!`);
        checkAchievements(); save(); updateUI(); return;
      }
    }
    type = 'boatpart';
  }
  const itemsPool = EQUIPMENT.filter(x => {
    if (x.id.indexOf('ded') !== -1) return false;
    if (type === 'boatpart') return ['motor', 'hull', 'radar', 'elec', 'hold'].includes(x.type) && x.price >= price * 0.3;
    return ['rod', 'reel', 'line', 'hook', 'float', 'bait'].includes(x.type) && x.price >= price * 0.3;
  });
  const drop = itemsPool[Math.floor(Math.random() * itemsPool.length)];
  if (drop) {
    if (!state.ownedEquip.includes(drop.id)) {
      state.ownedEquip.push(drop.id);
      state.equipDurability[drop.id] = 100;
      toast(`Выпало: ${drop.name}`);
    } else {
      state.equipDurability[drop.id] = 100;
      toast(`Выпало: ${drop.name}. Прочность восстановлена.`);
    }
  } else {
    state.money += Math.floor(price * 0.3);
    toast(`Пусто. Возврат.`);
  }
  checkAchievements();
  save(); updateUI();
}

function openFishCrate(price) {
  if (state.money < price) return toast('Мало денег');
  if (state.catch.length >= state.invCap) return toast('Инвентарь полон');
  state.money -= price;
  state.openedCrates++;
  const loc = LOCATIONS.find(l => l.id === state.currentLoc);
  const f = loc.fish[Math.floor(Math.random() * loc.fish.length)];
  state.catch.push({ name: f.name });
  state.caughtSpecies[f.name] = (state.caughtSpecies[f.name] || 0) + 1;
  checkAchievements();
  save(); updateUI();
  toast(`Выпала: ${f.name}`);
}

function renderFishers() {
  const c = document.getElementById('fisherRow');
  c.innerHTML = FISHERS.map(f => {
    const owned = state.ownedFishers.includes(f.id);
    return `<div class="loc-card" style="margin-bottom:6px; padding:8px; min-width:100px;"><div style="font-size:12px; font-weight:bold; color:#00d4ff; margin-bottom:4px;">${f.name}</div><div style="font-size:10px; color:#88bbdd; margin-bottom:6px;">${f.desc}</div>${owned ? `<button class="si-buy" disabled>Нанят</button>` : `<button class="si-buy" onclick="hireFisher('${f.id}', ${f.price})">$${f.price}</button>`}</div>`;
  }).join('');
  document.getElementById('fisherCount').textContent = `${state.ownedFishers.length}/${FISHERS.length}`;
}

function hireFisher(id, price) { if (state.money < price) return toast('Мало денег'); state.money -= price; state.ownedFishers.push(id); checkAchievements(); save(); updateUI(); toast('Нанят'); }

function renderCollection() {
  const c = document.getElementById('collList');
  const allFish = LOCATIONS.flatMap(l => l.fish);
  const uniqueFish = [];
  allFish.forEach(f => { if (!uniqueFish.find(x => x.name === f.name)) uniqueFish.push(f); });
  const opened = uniqueFish.filter(f => state.caughtSpecies[f.name] > 0).length;
  document.getElementById('collProgress').textContent = `${opened}/${uniqueFish.length}`;

  let html = '';
  LOCATIONS.forEach(loc => {
    html += `<div class="shop-category-title" style="margin-top:8px;">${loc.name}</div><div style="display:flex; flex-wrap:wrap; gap:4px; margin-bottom:8px;">`;
    loc.fish.forEach(f => {
      const caught = state.caughtSpecies[f.name] > 0;
      const color = f.rarity === 'common' ? '#aaa' : f.rarity === 'uncommon' ? '#00dd88' : f.rarity === 'rare' ? '#00aaff' : f.rarity === 'epic' ? '#cc66ff' : '#ffcc00';
      if (caught) html += `<div style="background:rgba(0,60,100,.5); border:1px solid ${color}55; border-radius:4px; padding:4px 6px; font-size:10px; font-weight:bold; text-align:center;"><div style="color:#fff;">${f.name}</div><div style="color:${color}; margin-top:2px;">${state.caughtSpecies[f.name]} шт</div></div>`;
      else html += `<div style="background:rgba(0,30,60,.5); border:1px dashed #555; border-radius:4px; padding:4px 6px; font-size:10px; font-weight:bold; text-align:center; opacity:.5;"><div style="color:#888;">???</div><div style="color:#555; margin-top:2px;">Закрыто</div></div>`;
    });
    html += `</div>`;
  });
  
  if (state.gameBeaten) {
    html += `<div class="achievement">🏆 ДОСТИЖЕНИЕ РАЗБЛОКИРОВАНО<br><br>НА РЫБАЛКЕ С ДЕДОМ</div>`;
  }

  html += `<div style="margin-top:10px;display:flex;justify-content:center"><button class="reset-btn" onclick="document.getElementById('resetModal').classList.add('show')">Сбросить прогресс</button></div>`;
  c.innerHTML = html;
}

function renderAchievements() {
  const c = document.getElementById('achList');
  const unlocked = state.achievementsUnlocked.length;
  document.getElementById('achProgress').textContent = `${unlocked}/${ACHIEVEMENTS.length}`;
  c.innerHTML = ACHIEVEMENTS.map(a => {
    const isUnlocked = state.achievementsUnlocked.includes(a.id);
    return `<div class="ach-item ${!isUnlocked ? 'locked' : ''}"><div class="ach-icon">${isUnlocked ? '🏆' : '🔒'}</div><div class="ach-info"><div class="ach-name">${a.name}</div><div class="ach-desc">${a.desc}</div></div></div>`;
  }).join('');
}

function renderBank() {
  const activeBox = document.getElementById('activeDeposits');
  const depTotal = state.deposits.reduce((s,d) => s + d.amount, 0);
  document.getElementById('depTotal').textContent = depTotal;
  if (state.deposits.length === 0) { activeBox.innerHTML = '<div class="inv-empty">Нет вкладов</div>'; } 
  else { activeBox.innerHTML = state.deposits.map(d => `<div class="active-dep"><div><div class="ad-name">${d.name}</div><div class="ad-status">Осталось: ${d.daysLeft} дн.</div></div><div class="ad-amount">+${d.amount}</div></div>`).join(''); }

  const depOpts = document.getElementById('depositOptions');
  let html = '';
  DEPOSIT_OPTIONS.forEach(d => {
    DEPOSIT_AMOUNTS.forEach(amt => {
      const profit = Math.floor(amt * d.rate * d.days);
      const canAfford = state.money >= amt;
      html += `<div class="dep-opt ${!canAfford?'disabled':''}" data-dep="${d.id}" data-amt="${amt}" onclick="openDeposit('${d.id}', ${amt})"><div><div class="dep-name">${d.name} · ${amt}</div><div class="dep-rate">${(d.rate*100).toFixed(1)}%/день</div></div><div class="dep-get">+${profit}<small>прибыль</small></div></div>`;
    });
  });
  depOpts.innerHTML = html;

  const crBox = document.getElementById('creditOptions');
  const hasDebt = state.credit && state.credit.owed > 0;
  if (hasDebt) { crBox.innerHTML = '<div class="inv-empty" style="text-align:center">Погасите долг!</div>'; document.getElementById('creditStatus').textContent = 'Есть долг'; document.getElementById('creditStatus').style.color = '#ff6666'; } 
  else {
    document.getElementById('creditStatus').textContent = 'Нет долга'; document.getElementById('creditStatus').style.color = '#00ff88';
    crBox.innerHTML = CREDIT_OPTIONS.map(c => { const total = Math.floor(c.sum * (1 + CREDIT_RATE)); return `<div class="dep-opt" onclick="takeCredit(${c.sum})"><div><div class="dep-name">Кредит: ${c.sum}</div><div class="dep-rate">${CREDIT_DAYS} дней</div></div><div class="dep-get" style="color:#ff6666">-${total}<small>отдать</small></div></div>`; }).join('');
  }

  const acCard = document.getElementById('activeCreditCard');
  if (hasDebt) {
    acCard.style.display = 'block';
    document.getElementById('acAmount').textContent = `${state.credit.owed}`;
    document.getElementById('activeCreditBox').innerHTML = `<div class="ac-row" style="display:flex;justify-content:space-between;margin-bottom:4px;font-size:10px;font-weight:bold;"><span>Взято:</span><span>${state.credit.sum}</span></div><div class="ac-row" style="display:flex;justify-content:space-between;margin-bottom:4px;font-size:10px;font-weight:bold;"><span>Дней:</span><span>${state.credit.daysLeft}</span></div><button class="si-buy" style="width:100%; margin-top:6px;" onclick="payCredit()" ${state.money < 1 ? 'disabled' : ''}>Погасить (${state.credit.owed})</button>`;
  } else { acCard.style.display = 'none'; }
}

function openDeposit(id, amt) { if (state.money < amt) return toast('Мало денег'); const d = DEPOSIT_OPTIONS.find(x => x.id === id); state.money -= amt; state.deposits.push({ id: d.id, name: d.name, amount: amt, rate: d.rate, days: d.days, daysLeft: d.days }); state.depositsCreated++; checkAchievements(); save(); updateUI(); toast(`Вклад ${amt} открыт`); }
function takeCredit(sum) { const total = Math.floor(sum * (1 + CREDIT_RATE)); state.money += sum; state.credit = { sum, owed: total, daysLeft: CREDIT_DAYS }; state.creditTakenCount++; checkAchievements(); save(); updateUI(); toast(`Кредит ${sum} получен!`); }
function payCredit() { if (!state.credit) return; const owed = state.credit.owed; if (state.money < owed) return toast('Мало денег'); state.money -= owed; state.credit = null; save(); updateUI(); toast('Кредит погашен!'); }

document.getElementById('pond').addEventListener('click', () => {
  if (state.catch.length >= state.invCap) return toast('Инвентарь полон');
  if (state.energy < 10) return toast('Вы устали! Нажмите "Отдохнуть"');
  
  const status = document.getElementById('status');
  status.textContent = 'ЖДЕМ...';
  
  state.energy -= 10;
  state.energySpent += 10;
  
  const eq = [...Object.values(state.rod), ...Object.values(state.boatParts)];
  eq.forEach(id => {
    const item = EQUIPMENT.find(x => x.id === id);
    if (item && id.indexOf('ded') === -1 && state.equipDurability[id] > 0) {
      state.equipDurability[id] = Math.max(0, state.equipDurability[id] - 2);
    }
  });
  
  save(); updateUI();

  const stats = getStats();
  const speedMult = 1 - (stats.spd / 100);
  const waitTime = (1500 + Math.random() * 1000) * Math.max(0.1, speedMult);
  
  setTimeout(() => {
    status.textContent = 'КЛЮЕТ!';
    setTimeout(() => {
      const loc = LOCATIONS.find(l => l.id === state.currentLoc);
      let totalWeight = 0;
      const pool = loc.fish.map(f => { let w = f.chance; if (f.rarity !== 'common') w += stats.lck; totalWeight += w; return { ...f, w }; });
      let r = Math.random() * totalWeight;
      let caught = pool[0];
      for(let f of pool) { if (r < f.w) { caught = f; break; } r -= f.w; }
      state.catch.push({ name: caught.name });
      addXP(FISH_META[caught.rarity].xp);
      state.caughtSpecies[caught.name] = (state.caughtSpecies[caught.name] || 0) + 1;
      const p = document.getElementById('pond');
      const el = document.createElement('div'); el.className = 'float-text'; el.textContent = `+${caught.name}`; el.style.left = '30%'; el.style.top = '40%';
      p.appendChild(el); setTimeout(() => el.remove(), 1000);
      status.textContent = `ПОЙМАЛ: ${caught.name}`;
      checkAchievements();
      save(); updateUI();
    }, 400);
  }, waitTime);
});

document.getElementById('sellBtn').addEventListener('click', () => {
  let total = 0;
  const initialCount = state.catch.length;
  state.catch = state.catch.filter(f => {
    const fData = LOCATIONS.flatMap(l=>l.fish).find(x=>x.name===f.name);
    if (fData && fData.price === 0) return true;
    total += getPrice(f.name); return false;
  });
  state.money += total; 
  state.totalMoneyEarned += total;
  if (initialCount > state.maxCatchSold) state.maxCatchSold = initialCount;
  checkAchievements();
  save(); updateUI(); toast(`+$${total}`);
});

document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.inventory').forEach(c => c.classList.remove('show'));
    document.getElementById('fishingView').style.display = 'none';
    tab.classList.add('active');
    const tabId = tab.dataset.tab;
    if (tabId === 'fishing') { document.getElementById('fishingView').style.display = 'flex'; } 
    else { document.getElementById(tabId + 'View').classList.add('show'); }
    updateUI();
  });
});

document.getElementById('closePick').addEventListener('click', () => document.getElementById('pickFishModal').classList.remove('show'));
document.getElementById('cancelReset').addEventListener('click', () => document.getElementById('resetModal').classList.remove('show'));

LOCATIONS.forEach(l => l.fish.forEach(f => { if (!state.marketPrices[f.name]) state.marketPrices[f.name] = f.price; }));
updateUI();
checkAchievements();

setInterval(() => { if(Math.random() > 0.3) spawnFish(); }, 2000);

// ТАЙМЕР ДНЕЙ
let secondsToDay = 60;
setInterval(() => {
  secondsToDay--;
  if (secondsToDay <= 0) {
    secondsToDay = 60;
    state.day++;
    LOCATIONS.forEach(loc => {
      loc.fish.forEach(f => {
        if (f.price > 0) {
          let change = 0.8 + Math.random() * 0.4;
          state.marketPrices[f.name] = Math.max(1, Math.floor(f.price * change));
        }
      });
    });
    save(); updateUI();
    toast('Новый день! Цены изменились');
  }
}, 1000);
</script>
