function useEnergy(id) {
  if (!state.inventoryEnergy[id] || state.inventoryEnergy[id] <= 0) return;
  const item = CONSUMABLES.find(x => x.id === id);
  state.inventoryEnergy[id]--;
  state.energy = Math.min(state.maxEnergy, state.energy + item.energy);
  save(); updateUI();
  toast(`Использовано: ${item.name} (+${item.energy} энергии)`);
}

function repairItem(id, event) {
  event.stopPropagation();
  const item = EQUIPMENT.find(x => x.id === id);
  const dur = state.equipDurability[id] || 0;
  if (dur >= 100) return;
  const cost = Math.floor(REPAIR_BASE[item.rarity] * (1 - dur / 100));
  if (state.money < cost) return toast(`Нужно $${cost}`);
  state.money -= cost;
  state.equipDurability[id] = 100;
  state.repairedCount++;
  checkAchievements();
  save(); updateUI();
  toast(`Отремонтировано за $${cost}`);
}

document.getElementById('restBtn').addEventListener('click', () => {
  const missing = state.maxEnergy - state.energy;
  const daysToRest = Math.ceil(missing / 30);
  if (daysToRest <= 0) return toast('Вы полны сил!');
  
  state.day += daysToRest;
  state.energy = state.maxEnergy;
  state.restedCount++;
  
  LOCATIONS.forEach(loc => {
    loc.fish.forEach(f => {
      if (f.price > 0) {
        let change = 0.8 + Math.random() * 0.4;
        state.marketPrices[f.name] = Math.max(1, Math.floor(f.price * change));
      }
    });
  });
  
  for(let i=0; i<daysToRest; i++) {
    state.deposits.forEach(d => {
      d.daysLeft--;
      if (d.daysLeft <= 0) {
        const profit = Math.floor(d.amount * d.rate * d.days);
        state.money += d.amount + profit;
        state.totalMoneyEarned += profit;
        d.dead = true;
      }
    });
    state.deposits = state.deposits.filter(d => !d.dead);
  }
  checkAchievements();
  save(); updateUI();
  toast(`Вы отдохнули ${daysToRest} дн.`);
});

document.getElementById('expandInv').addEventListener('click', () => {
  if (state.money < state.invExpandCost) return toast('Мало денег');
  state.money -= state.invExpandCost;
  state.invCap += 5;
  state.invExpandCost = Math.floor(state.invExpandCost * 1.5);
  save(); updateUI();
  toast('Корзина расширена!');
});

