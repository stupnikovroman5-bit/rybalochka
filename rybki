    el.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;width:100%;">${item.name} ${repairHtml}</div>${durStr}`;
  };

  renderSlot('rod', 'rod', 'gRod'); renderSlot('rod', 'reel', 'gReel'); renderSlot('rod', 'line', 'gLine'); renderSlot('rod', 'hook', 'gHook'); renderSlot('rod', 'float', 'gFloat'); renderSlot('rod', 'bait', 'gBait');
  renderSlot('boat', 'motor', 'gMotor'); renderSlot('boat', 'hull', 'gHull'); renderSlot('boat', 'radar', 'gRadar'); renderSlot('boat', 'elec', 'gElec'); renderSlot('boat', 'hold', 'gHold');

